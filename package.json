{
  "name": "finanzapp-front",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "App móvil de Finanzas Personales (Expo + React Native Paper)",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "expo": "57.0.24",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.88.0",
    "react-native": "^0.86.3",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "eslint": "10.11.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "openapi-typescript": "^7.13.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "sync-contract": "./scripts/sync-contract.sh",
    "build:web": "expo export --platform web"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-paper|react-native-vector-icons|react-native-safe-area-context|react-native-screens|@tanstack/.*|openapi-fetch))"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ]
  }
}
