# Copiar a .env (ignorado por git). Solo valores públicos de desarrollo.
# Web / iOS simulador:
EXPO_PUBLIC_API_URL=http://localhost:3000
# Android emulador: http://10.0.2.2:3000 · dispositivo físico: http://<IP-de-tu-PC>:3000
# Login de desarrollo (requiere AUTH_SANDBOX=true en el back). Sin Google/Apple configurados es la única forma de entrar.
EXPO_PUBLIC_AUTH_SANDBOX=true
